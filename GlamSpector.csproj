<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.3.15.6</Version>
    <AssemblyName>GlamSpector</AssemblyName>
    <RootNamespace>GlamSpector</RootNamespace>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\Fonts\NotoSans-Regular.ttf" />
    <None Remove="Assets\Fonts\NotoSans-Bold.ttf" />
    <EmbeddedResource Include="Assets\Fonts\NotoSans-Regular.ttf"
                      LogicalName="GlamSpector.Assets.Fonts.NotoSans-Regular.ttf" />
    <EmbeddedResource Include="Assets\Fonts\NotoSans-Bold.ttf"
                      LogicalName="GlamSpector.Assets.Fonts.NotoSans-Bold.ttf" />
  </ItemGroup>
</Project>
